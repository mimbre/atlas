# Python configuration tools
__pycache__/
*.pyc
# What the umbrella's apps (products/software_factory, apps_path ../../platform) leave in
# their own folders when run one by one
platform/atlas_*/_build/
platform/atlas_*/deps/
platform/atlas_*/tmp/
# What SwiftPM builds next to any Swift package
.build/
# Generated targets: bin/generate writes them from the contracts at build time; they are
# not kept in git. Only the hand-written files inside these folders are tracked.
/products/software_factory/model/targets/*
!/products/software_factory/model/targets/rela/
/products/software_factory/model/targets/rela/*
!/products/software_factory/model/targets/rela/data-entry.yaml
!/products/software_factory/model/targets/rela/schedules.yaml
!/products/software_factory/model/targets/rela/scripts/
/platform/atlas_control/backend/targets/*
!/platform/atlas_control/backend/targets/swift/
/platform/atlas_control/backend/targets/swift/*
!/platform/atlas_control/backend/targets/swift/Tests/
/platform/atlas_control/backend/targets/swift/Tests/*
!/platform/atlas_control/backend/targets/swift/Tests/Fixtures/
/platform/atlas_runtime/*/targets/*
!/platform/atlas_runtime/backend/targets/.gitkeep
/platform/atlas_code/boundary/targets/

{
  "version": 1,
  "rows": [
    {
      "id": "dedicated_ok",
      "fs": [
        {
          "path": "{user}",
          "type": "dir"
        },
        {
          "path": "{tmp}/repo",
          "type": "git"
        }
      ],
      "input": {
        "origin": {
          "runtime_chosen": {
            "work": "w1"
          }
        },
        "path": "{tmp}/repo"
      },
      "expect": {
        "git_dir": "{tmp}/repo/.git",
        "network_hosts": [
          "github.com",
          "api.github.com"
        ],
        "profile": "dedicated-repository",
        "root": "{tmp}/repo",
        "version": 1
      }
    },
    {
      "id": "dedicated_alias_not_canonical",
      "fs": [
        {
          "path": "{user}",
          "type": "dir"
        },
        {
          "path": "{tmp}/repo",
          "type": "git"
        },
        {
          "path": "{tmp}/alias",
          "target": "{tmp}/repo",
          "type": "symlink"
        }
      ],
      "input": {
        "origin": {
          "runtime_chosen": {
            "work": "w1"
          }
        },
        "path": "{tmp}/alias"
      },
      "expect": {
        "error": "Dedicated repository requires a canonical root with its own .git directory"
      }
    },
    {
      "id": "dedicated_dotdot_not_canonical",

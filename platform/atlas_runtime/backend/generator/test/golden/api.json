{
  "events": [
    {
      "id": "sequence",
      "model": "book_changed",
      "name": "book"
    },
    {
      "model": "tick",
      "name": "tick"
    },
    {
      "id": "current_sequence",
      "model": "restart",
      "name": "restart"
    }
  ],
  "exposed": [
    "lend",
    "find_book",
    "search",
    "list_books",
    "give_back",
    "count",
    "watch",
    "scan"
  ],
  "not_exposed": [
    "audit"
  ],
  "rights": [
    {
      "listener": "socket",
      "rights": [
        "lend",
        "browse"
      ]
    },
    {
      "listener": "guest",
      "rights": [
        "browse"
      ]
    }
  ],
  "targets": [
    {
      "carries": "entities",
      "errors": [
        {
          "kind": "invalid",
          "status": 400,
          "type": "invalid"
        },
        {
          "kind": "not_permitted",
          "status": 403,
          "type": "not-permitted"
        },
        {
          "kind": "no_route",
          "status": 404,
          "type": "no-route"
        },
        {
          "kind": "unauthenticated",
          "status": 401,
          "type": "unauthenticated"
        },
        {
          "kind": "origin_refused",
          "status": 403,
          "type": "origin-refused"
        }
      ],
      "name": "rest",
      "resources": [
        {
          "body": [
            "title",
            "place",
            "until"
          ],
          "capability": "lend",
          "headers": {
            "request-key": "request_key"
          },
          "method": "POST",
          "path": "/v1/books",
          "query": {}
        },
        {
          "capability": "find_book",
          "etag": "edition",
          "headers": {},
          "method": "GET",
          "path": "/v1/books/:book_id",
          "query": {}
        },
        {
          "capability": "search",
          "headers": {},
          "method": "GET",
          "path": "/v1/books",
          "query": {
            "title": "title"
          }
        },
        {
          "capability": "list_books",
          "headers": {},
          "method": "GET",
          "path": "/v1/books",
          "query": {
            "condition": "condition",
            "lent": "lent",
            "limit": "limit"
          }
        },
        {
          "body": [
            "note",
            "hurry"
          ],
          "capability": "give_back",
          "headers": {},
          "method": "POST",
          "path": "/v1/books/:book_id/return",
          "query": {}
        },
        {
          "capability": "count",
          "headers": {},
          "method": "GET",
          "path": "/v1/count",
          "query": {}
        },
        {
          "capability": "scan",
          "headers": {},
          "method": "GET",
          "path": "/v1/books/:book_id/scan",
          "query": {}
        }
      ],
      "statuses": [
        {
          "body": "book",
          "headers": {
            "location": "/v1/books/{book.book_id}"
          },
          "outcome": "lent",
          "status": 201
        },
        {
          "headers": {
            "retry-after": "retry_after"
          },
          "outcome": "busy",
          "status": 503,
          "type": "busy"
        },
        {
          "by": "reason",
          "cases": [
            {
              "status": 400,
              "type": "invalid",
              "value": "invalid"
            },
            {
              "status": 409,
              "type": "taken",
              "value": "taken"
            },
            {
              "status": 403,
              "type": "not-permitted",
              "value": "not_permitted"
            }
          ],
          "headers": {},
          "outcome": "refused"
        },
        {
          "body": "book",
          "headers": {},
          "outcome": "found",
          "status": 200
        },
        {
          "headers": {},
          "outcome": "missing",
          "status": 404,
          "type": "not-found"
        },
        {
          "headers": {},
          "outcome": "listed",
          "status": 200
        },
        {
          "headers": {},
          "outcome": "returned",
          "status": 200
        },
        {
          "headers": {
            "retry-after": "wait"
          },
          "outcome": "counted",
          "status": 200
        },
        {
          "content_type": "application/octet-stream",
          "headers": {
            "scan-of": "/v1/books/{book_id}",
            "scan-pages": "pages",
            "scanned-at": "scanned_at"
          },
          "outcome": "scanned",
          "status": 200,
          "stream": "content"
        }
      ],
      "streams": [
        {
          "capability": "watch",
          "events": [
            "book",
            "tick",
            "restart"
          ],
          "into": "from",
          "open": {
            "restart": "restart",
            "watching": null
          },
          "path": "/v1/events",
          "resume_header": "last-event-id"
        }
      ]
    }
  ],
  "version": "1.0.0"
}

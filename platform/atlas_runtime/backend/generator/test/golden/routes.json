{
  "carries": "entities",
  "errors": [
    {
      "kind": "invalid",
      "status": 400,
      "type": "invalid"
    },
    {
      "kind": "not_permitted",
      "status": 403,
      "type": "not-permitted"
    },
    {
      "kind": "no_route",
      "status": 404,
      "type": "no-route"
    },
    {
      "kind": "unauthenticated",
      "status": 401,
      "type": "unauthenticated"
    },
    {
      "kind": "origin_refused",
      "status": 403,
      "type": "origin-refused"
    }
  ],
  "events": [
    {
      "id": "sequence",
      "model": "book_changed",
      "name": "book"
    },
    {
      "model": "tick",
      "name": "tick"
    },
    {
      "id": "current_sequence",
      "model": "restart",
      "name": "restart"
    }
  ],
  "listeners": [
    {
      "name": "socket",
      "rights": [
        "lend",
        "browse"
      ]
    },
    {
      "name": "guest",
      "rights": [
        "browse"
      ]
    }
  ],
  "routes": [
    {
      "body": [
        "title",
        "place",
        "until"
      ],
      "capability": "lend",
      "headers": {
        "request-key": {
          "field": "request_key",
          "required": false
        }
      },
      "method": "POST",
      "outcomes": [
        {
          "body": "book",
          "headers": {
            "location": "/v1/books/{book.book_id}"
          },
          "outcome": "lent",
          "status": 201
        },
        {
          "headers": {
            "retry-after": "retry_after"
          },
          "outcome": "busy",
          "status": 503,
          "type": "busy"
        },
        {
          "by": "reason",
          "cases": [
            {
              "status": 400,
              "type": "invalid",
              "value": "invalid"
            },
            {
              "status": 409,
              "type": "taken",
              "value": "taken"
            },
            {
              "status": 403,
              "type": "not-permitted",
              "value": "not_permitted"
            }
          ],
          "headers": {},
          "outcome": "refused"
        }
      ],
      "params": [],
      "path": "/v1/books",
      "query": {},
      "right": "lend"
    },
    {
      "capability": "find_book",
      "etag": {
        "field": "edition",
        "not_modified": 304,
        "request_header": "if-none-match"
      },
      "headers": {},
      "method": "GET",
      "outcomes": [
        {
          "body": "book",
          "headers": {},
          "outcome": "found",
          "status": 200
        },
        {
          "headers": {},
          "outcome": "missing",
          "status": 404,
          "type": "not-found"
        }
      ],
      "params": [
        "book_id"
      ],
      "path": "/v1/books/{book_id}",
      "query": {},
      "right": "browse"
    },
    {
      "capability": "search",
      "headers": {},
      "method": "GET",
      "outcomes": [
        {
          "body": "book",
          "headers": {},
          "outcome": "found",
          "status": 200
        },
        {
          "headers": {},
          "outcome": "missing",
          "status": 404,
          "type": "not-found"
        }
      ],
      "params": [],
      "path": "/v1/books",
      "query": {
        "title": {
          "field": "title",
          "required": true
        }
      },
      "right": "browse"
    },
    {
      "capability": "list_books",
      "headers": {},
      "method": "GET",
      "outcomes": [
        {
          "headers": {},
          "outcome": "listed",
          "status": 200
        }
      ],
      "params": [],
      "path": "/v1/books",
      "query": {
        "condition": {
          "field": "condition",
          "required": false
        },
        "lent": {
          "field": "lent",
          "required": false
        },
        "limit": {
          "field": "limit",
          "required": false
        }
      },
      "right": "browse"
    },
    {
      "body": [
        "note",
        "hurry"
      ],
      "capability": "give_back",
      "headers": {},
      "method": "POST",
      "outcomes": [
        {
          "headers": {
            "replayed": "true"
          },
          "outcome": "returned",
          "status": 200
        },
        {
          "headers": {},
          "outcome": "missing",
          "status": 404,
          "type": "not-found"
        }
      ],
      "params": [
        "book_id"
      ],
      "path": "/v1/books/{book_id}/return",
      "query": {},
      "right": "lend"
    },
    {
      "capability": "count",
      "headers": {},
      "method": "GET",
      "outcomes": [
        {
          "headers": {
            "retry-after": "wait"
          },
          "outcome": "counted",
          "status": 200
        }
      ],
      "params": [],
      "path": "/v1/count",
      "query": {},
      "right": "browse"
    },
    {
      "capability": "watch",
      "headers": {},
      "method": "GET",
      "outcomes": [
        {
          "headers": {
            "content-type": "text/event-stream"
          },
          "opens_with": null,
          "outcome": "watching",
          "status": 200
        },
        {
          "headers": {
            "content-type": "text/event-stream"
          },
          "opens_with": "restart",
          "outcome": "restart",
          "status": 200
        }
      ],
      "params": [],
      "path": "/v1/events",
      "query": {},
      "right": "browse",
      "stream": {
        "events": [
          "book",
          "tick",
          "restart"
        ],
        "into": "from",
        "resume_header": "last-event-id"
      }
    }
  ],
  "target": "rest",
  "version": "1.0.0"
}

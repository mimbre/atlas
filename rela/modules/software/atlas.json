{
  "types": {
    "github_pull_url": {
      "format": "url"
    }
  },
  "relations": {
    "in_issue": {
      "parent": true
    },
    "done_in": {
      "set_by": [
        "migration",
        "connector"
      ]
    }
  },
  "entities": {
    "issue": {
      "create": {
        "ask": [
          "title",
          "description"
        ]
      },
      "properties": {
        "description": {
          "multiline": true
        },
        "flux_id": {
          "set_by": "connector"
        },
        "flux_ref": {
          "set_by": "connector"
        }
      }
    },
    "pull_request": {
      "primary": "title",
      "create": {
        "ask": [
          "url"
        ],
        "id": {
          "from": "url",
          "pattern": "^https://github\\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/pull/([0-9]+)$",
          "template": "PR-{1}-{2}-{3}",
          "replace": {
            ".": "_"
          },
          "error": "url must be a GitHub pull request URL, e.g. https://github.com/eyra/atlas/pull/12"
        }
      },
      "properties": {
        "title": {
          "set_by": "connector"
        },
        "state": {
          "set_by": "connector"
        },
        "draft": {
          "set_by": "connector"
        }
      },
      "connector": {
        "system": "github",
        "address": "url",
        "fields": {
          "title": "title",
          "state": "state",
          "draft": "isDraft"
        },
        "until": {
          "state": [
            "merged",
            "closed"
          ]
        }
      }
    }
  }
}

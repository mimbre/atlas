{
  "todo": {
    "title": "What to do",
    "why": "Why",
    "instructions": "How",
    "answers": "Answers"
  },
  "runtime": {
    "turn": {
      "kind": "turn",
      "key": "TU-{on}-{n}",
      "on": "turn_on",
      "by": "turn_by",
      "state": "state",
      "running": "running",
      "ended": "ended",
      "machine": "machine",
      "lease": "lease_until",
      "activity": "activity",
      "why": "why",
      "ended_at": "ended_at",
      "outcome": "outcome",
      "attempt": "attempt"
    },
    "agent": {
      "cannot_run": "cannot_run"
    }
  },
  "start": {
    "assigned": {
      "relation": "assigned_to",
      "title": "Assigned to you",
      "count": "{count} assigned to you"
    },
    "open": {
      "title": "Open work",
      "empty": "Nothing is open: no fact is assigned to anyone, and nothing is expected."
    }
  },
  "relations": {
    "assigned_to": {
      "actions": {
        "change": {
          "label": "Hand to\u2026",
          "key": "h",
          "with": [
            "deadline"
          ],
          "cause": "handed to {to} by {by}"
        }
      }
    },
    "decided_by": {
      "only_target": {
        "error": "only the one who decides sets decided_by, to themselves",
        "also": [
          "migration"
        ]
      }
    },
    "overruled_by": {
      "only_target": {
        "error": "only the person who overrules a verdict sets overruled_by, to themselves",
        "also": [
          "migration"
        ]
      }
    }
  },
  "entities": {
    "person": {
      "top": false,
      "primary": "name",
      "create": {
        "ask": [
          "name"
        ],
        "id": {
          "from": "name",
          "pattern": "^\\s*([A-Za-z][A-Za-z0-9]*)",
          "template": "{1}",
          "lower": true,
          "error": "name must start with a letter, e.g. Melle"
        }
      }
    },
    "assignment": {
      "top": false,
      "by_hand": "update",
      "late": {
        "after": "deadline",
        "while": "expected",
        "label": "late"
      },
      "primary": "of",
      "create": {
        "ask": [
          "of"
        ],
        "id": {
          "from": "of",
          "pattern": "^(.+)$",
          "template": "AS-{1}",
          "error": "of must be the key of the fact it belongs to"
        }
      },
      "properties": {
        "expected": {
          "set_by": [
            "flow",
            "migration"
          ]
        },
        "handover": {
          "set_by": [
            "flow"
          ]
        }
      }
    },
    "turn": {
      "top": false,
      "by_hand": false,
      "order": "newest",
      "properties": {
        "state": {
          "set_by": [
            "runtime"
          ]
        },
        "machine": {
          "set_by": [
            "runtime"
          ]
        },
        "lease_until": {
          "set_by": [
            "runtime"
          ],
          "label": "Lease until"
        },
        "activity": {
          "set_by": [
            "runtime"
          ]
        },
        "why": {
          "set_by": [
            "runtime"
          ]
        },
        "ended_at": {
          "set_by": [
            "runtime"
          ],
          "label": "Ended at"
        },
        "outcome": {
          "set_by": [
            "turn_owner"
          ],
          "multiline": true
        },
        "attempt": {
          "set_by": [
            "runtime"
          ]
        }
      }
    },
    "agent": {
      "properties": {
        "cannot_run": {
          "set_by": [
            "runtime"
          ],
          "label": "Cannot run"
        }
      },
      "top": false,
      "counts": [
        {
          "relation": "assigned_to",
          "text": "{count} assigned"
        }
      ],
      "primary": "name",
      "create": {
        "ask": [
          "name"
        ],
        "id": {
          "from": "name",
          "pattern": "^\\s*([A-Za-z][A-Za-z0-9]*)",
          "template": "{1}",
          "lower": true,
          "error": "name must start with a letter, e.g. Coordinator"
        }
      }
    },
    "worker_execution": {
      "top": false,
      "by_hand": false
    },
    "interaction": {
      "top": false,
      "by_hand": false
    },
    "interaction_receipt": {
      "top": false,
      "by_hand": false
    },
    "decision": {
      "primary": "title",
      "order": "newest",
      "create": {
        "ask": [
          "title",
          "decision",
          "context",
          "consequences",
          "category",
          "scope",
          "reversibility",
          "force",
          "enforced_by"
        ],
        "id": {
          "prefix": "D-",
          "digits": 4,
          "first": 24
        },
        "defaults": {
          "status": "proposed"
        }
      },
      "properties": {
        "decision": {
          "multiline": true
        },
        "context": {
          "multiline": true
        },
        "consequences": {
          "multiline": true
        },
        "enforced_by": {
          "label": "Enforced by"
        },
        "decided_at": {
          "label": "Decided at"
        }
      },
      "requires": [
        {
          "when": {
            "force": [
              "principle"
            ]
          },
          "fields": [
            "enforced_by"
          ],
          "error": "a principle names the check that enforces it (enforced_by)"
        }
      ],
      "authority": {
        "when": {
          "status": [
            "accepted"
          ]
        },
        "by": "decided_by",
        "kind": "person",
        "only_kind_when": [
          {
            "category": [
              "product",
              "security"
            ]
          },
          {
            "reversibility": [
              "one_way"
            ]
          },
          {
            "force": [
              "principle"
            ]
          }
        ],
        "delegated_by": "delegated_by",
        "error": "a product, security, one-way or principle decision is accepted by a person; any other by a person, or by an agent with delegated_by",
        "writes": {
          "status": [
            "accepted",
            "rejected"
          ]
        },
        "writer_error": "only the one decided_by names accepts or rejects it, as themselves; an agent only under delegated_by, and never a product, security, one-way or principle decision"
      },
      "frozen": {
        "when": {
          "status": [
            "accepted",
            "superseded"
          ]
        },
        "only": {
          "status": [
            "superseded"
          ]
        },
        "error": "{key} is {value} and is never edited; a newer decision supersedes it"
      },
      "replaces": {
        "relation": "supersedes",
        "when": {
          "status": [
            "accepted"
          ]
        },
        "of": {
          "status": [
            "accepted",
            "superseded"
          ]
        },
        "set": {
          "status": "superseded"
        },
        "error": "{key} is not accepted; only an accepted decision is superseded"
      },
      "layering": {
        "relation": "follows_from",
        "field": "scope",
        "not": {
          "platform": [
            "software",
            "instance"
          ]
        },
        "error": "{key} ({value}) may not follow from {other} ({other_value}): a platform decision never depends on a software or instance one"
      }
    },
    "gate_verdict": {
      "top": false,
      "primary": "gate",
      "order": "newest",
      "create": {
        "ask": [
          "gate",
          "gate_version",
          "flavor",
          "purpose",
          "subject",
          "fingerprint",
          "evidence",
          "evidence_digest",
          "rule_outcome",
          "rule_version",
          "advisor",
          "model",
          "rationale",
          "scores",
          "verdict",
          "allowed_outcomes",
          "unsettled",
          "cost",
          "duration_ms",
          "decided_at"
        ],
        "id": {
          "prefix": "GV-",
          "digits": 4
        }
      },
      "properties": {
        "gate_version": {
          "label": "Gate version"
        },
        "evidence": {
          "multiline": true
        },
        "evidence_digest": {
          "label": "Evidence digest"
        },
        "rule_outcome": {
          "label": "Rule outcome"
        },
        "rule_version": {
          "label": "Rule version"
        },
        "rationale": {
          "multiline": true
        },
        "scores": {
          "multiline": true
        },
        "allowed_outcomes": {
          "label": "Allowed outcomes"
        },
        "duration_ms": {
          "label": "Duration (ms)"
        },
        "decided_at": {
          "label": "Decided at"
        },
        "overrule_reason": {
          "label": "Overrule reason",
          "multiline": true
        },
        "rework_after": {
          "label": "Rework after",
          "multiline": true
        },
        "defect_after": {
          "label": "Defect after",
          "multiline": true
        },
        "effort": {
          "multiline": true
        }
      },
      "requires": [
        {
          "when": {
            "flavor": [
              "rule"
            ]
          },
          "fields": [
            "rule_outcome",
            "rule_version"
          ],
          "error": "a rule gate's verdict names its rule_outcome and rule_version"
        },
        {
          "when": {
            "flavor": [
              "smart"
            ]
          },
          "fields": [
            "rule_outcome",
            "rule_version",
            "advisor",
            "model",
            "rationale"
          ],
          "error": "a smart gate's verdict names its rule_outcome, rule_version and the advice: advisor, model and rationale"
        }
      ],
      "sealed": {
        "once": [
          "overrule_reason",
          "rework_after",
          "defect_after",
          "effort"
        ],
        "links": "once",
        "error": "{key} is a gate verdict and is never edited ({field}); record a new verdict that follows it",
        "once_error": "{key}: {field} is set once and never changed"
      }
    }
  },
  "guidance": {
    "execution": {
      "kind": "worker_execution",
      "fields": {
        "environment": "environment",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "machine": "machine",
        "harness": "harness",
        "harness_version": "harness_version",
        "configured_model": "configured_model",
        "reported_model": "reported_model",
        "capability_version": "capability_version",
        "queued_input": "queued_input",
        "durable_accept_query": "durable_accept_query",
        "consumption_evidence": "consumption_evidence",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    },
    "interaction": {
      "kind": "interaction",
      "fields": {
        "environment": "environment",
        "actor": "actor",
        "client_key": "client_key",
        "body": "body",
        "body_digest": "body_digest",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "mode": "mode",
        "execution": "execution",
        "cause": "cause",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    },
    "receipt": {
      "kind": "interaction_receipt",
      "fields": {
        "environment": "environment",
        "interaction": "interaction",
        "worker": "worker",
        "turn": "turn",
        "attempt": "attempt",
        "execution": "execution",
        "stage": "stage",
        "evidence_id": "evidence_id",
        "admission_id": "admission_id",
        "consumption_id": "consumption_id",
        "reason": "reason",
        "writer": "writer",
        "cause": "cause",
        "recorded_at": "recorded_at",
        "recorded_position": "recorded_position"
      }
    }
  }
}

{
  "env": "prod",
  "tui_user": "melle",
  "actors": { "decider": "melle" },
  "control": {
    "host": "::",
    "tls": {"certfile_env": "ATLAS_TLS_CERTFILE", "keyfile_env": "ATLAS_TLS_KEYFILE"},
    "port": 7591,
    "tabs": [{ "id": "workers", "label": "Workers", "to": "/workers" }],
    "workers": {
      "read": { "actors": ["melle"] },
      "submit": { "actors": ["melle"] }
    }
  },
  "bus_link": { "tls": {"certfile_env": "ATLAS_TLS_CERTFILE", "keyfile_env": "ATLAS_TLS_KEYFILE"}, "host": "::", "port": 7594 },
  "rela": {
    "url": "http://eyra-atlas-rela.internal:7590/api/v1",
    "ipv6": true
  },
  "facts": { "data": "/data/beam" },
  "connectors": {
    "github": {
      "api": "https://api.github.com",
      "token_env": "GITHUB_TOKEN",
      "every_seconds": 300
    }
  },
  "reconcile_seconds": 5
}

{
  "env": "test",
  "tui_user": "melle",
  "fly": {
    "app": "eyra-atlas-test",
    "rela_app": "eyra-atlas-test-rela",
    "local": "~/.local/share/atlas/test-on-fly",
    "move_from": "~/.local/share/atlas/test"
  },
  "control": {
    "host": null,
    "host_env": "ATLAS_CONTROL_TEST_HOST",
    "tls": {},
    "port": 7691,
    "tabs": [{ "id": "workers", "label": "Workers", "to": "/workers" }],
    "workers": {
      "read": { "actors": ["melle", "releaseviewer", "releasewriter"] },
      "submit": { "actors": ["melle", "releasewriter"] }
    }
  },
  "reconcile_seconds": 5,
  "agent": { "planner": "claude", "step_pause_ms": 500, "ask_above": 1 }
}

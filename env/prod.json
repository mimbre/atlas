{
  "env": "prod",
  "tui_user": "melle",
  "fly": {
    "app": "eyra-atlas",
    "rela_app": "eyra-atlas-rela",
    "in_use": true,
    "local": "~/.local/share/atlas/prod-on-fly",
    "move_from": "~/.local/share/atlas/prod"
  },
  "control": {
    "host": null,
    "host_env": "ATLAS_CONTROL_PROD_HOST",
    "tls": {},
    "port": 7591,
    "tabs": [{ "id": "workers", "label": "Workers", "to": "/workers" }],
    "workers": {
      "read": { "actors": ["melle"] },
      "submit": { "actors": ["melle"] }
    }
  },
  "reconcile_seconds": 5,
  "agent": { "planner": "claude", "step_pause_ms": 300, "ask_above": 1 }
}

{
  "env": "prod",
  "tui_user": "melle",
  "actors": { "decider": "melle" },
  "assists": {
    "architect": "melle",
    "coordinator": "melle",
    "dev1": "melle",
    "dev2": "melle",
    "dev3": "melle",
    "dev4": "melle",
    "dev5": "melle",
    "dev6": "melle"
  },
  "control": {
    "host": "::",
    "port": 7591,
    "tabs": [{ "id": "workers", "label": "Workers", "to": "/workers", "icon": "machines" }],
    "workers": {
      "read": { "actors": ["melle"] },
      "submit": { "actors": ["melle"] }
    }
  },
  "bus_link": { "host": "::", "port": 7594 },
  "rela": {
    "url": "http://eyra-atlas-rela.internal:7590/api/v1",
    "ipv6": true
  },
  "facts": { "data": "/data/beam" },
  "flow": {
    "work_source": {
      "port": 7596,
      "credentials_env": "ATLAS_WORK_SOURCE_CREDENTIALS",
      "results": "/data/flow-results"
    }
  },
  "code": {
    "data": "/data/code",
    "git_port": 7597,
    "repositories": ["mimbre/atlas"],
    "home": "/data/code-home",
    "sources": {
      "github.com/mimbre/atlas": {
        "url": "https://github.com/mimbre/atlas.git",
        "credentials": "none"
      }
    }
  },
  "connectors": {
    "github": {
      "api": "https://api.github.com",
      "token_env": "GITHUB_TOKEN",
      "every_seconds": 300
    }
  },
  "reconcile_seconds": 5
}

#!/usr/bin/env bash
# atlas-ops: operate an Atlas environment and its processes, from any folder.
#
#   atlas-ops status       what runs, which build, and whether rela runs this build's
#                          description; on Fly: whether Control answers over the tailnet,
#                          and both apps' machines
#   atlas-ops logs         follow the core's log
#   atlas-ops restart      stop the core and start this build in the background; rela too:
#                          started when it does not answer, restarted when it runs an older
#                          description than this build (its data stays)
#   atlas-ops up           run the core in the foreground (what restart starts in the background)
#   atlas-ops stop [--rela]   stop the core; with --rela, rela too
#   atlas-ops env          the environment a command works on, and its settings file
#   atlas-ops where        the folder the build comes from
#   atlas-ops main-clone   the main clone, which `atlas tui` updates to the newest develop
#   atlas-ops install      link `atlas` and `atlas-ops` into ~/.local/bin (from the main clone only)
#
# On Fly (IS-Atlas-26, IS-Atlas-79): an environment whose settings have a "fly" section runs
# its core and rela on Fly, each environment on its own private network; a merge deploys
# them (develop: test, master: prod), so restart, up and stop refuse, and status and logs
# show Fly's machines and logs. Its Control is on the tailnet (D-0089), at control.host and
# control.port of the settings; this machine reaches it there, or not at all (tailscale
# status). With "in_use": false in that section (an environment whose
# data has not moved and been checked yet) the core and rela still run on this machine, and
# only the two commands below go to Fly.
#   atlas-ops move-to-fly [--from <folder>] [--dry-run] [--replace-live]   copy this
#                      machine's data (rela/ and beam/ in <folder>, by default the
#                      environment's folder here) to the Fly apps, replacing theirs (kept
#                      there in /data/before-move), and check every file arrived as sent
#   atlas-ops fetch-from-fly --to <folder> [--hold]   copy the data on Fly to this machine (a
#                      backup, or a migration on a copy); --hold keeps Fly serving nothing
#                      after it, until a move-to-fly brings the migrated data
#
# Every command works on prod unless it gets --env test: `atlas-ops status --env test`.
# Scripts and tests always pass --env test, or ATLAS_ENV_FILE: a private instance (other
# ports and data) whose environment is the file's "env". --env and the file's "env" must
# agree; `atlas` resolves environments the same way (bin/lib/env.sh).
set -euo pipefail

# Nothing here needs the Runtime read capability; keep it from every child.
unset ATLAS_RUNTIME_READ_TOKEN

# The repository this script lives in, also when it is called through a link.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd -P)"
prog=atlas-ops
. "$root/bin/lib/env.sh"
# The comment above, up to `set -euo pipefail`: the usage.
header() { sed -n '2,/^set -euo/p' "$root/bin/atlas-ops" | sed '$d' | sed 's/^# \{0,1\}//'; }
usage() { header; exit 2; }
unknown() { echo "atlas-ops: unknown option $1" >&2; usage; }

case "${1:-}" in
  status|logs|restart|up|stop|env|where|main-clone|install|move-to-fly|fetch-from-fly) cmd="$1"; shift ;;
  -h|--help|"") usage ;;
  *) echo "atlas-ops: unknown command $1" >&2; usage ;;
esac
take_env "$@"
args=()
rela=""
for arg in ${rest[@]+"${rest[@]}"}; do
  case "$cmd" in
    move-to-fly|fetch-from-fly) args+=("$arg"); continue ;;
  esac
  case "$arg" in -h|--help) usage ;; esac
  case "$cmd" in
    stop) [ "$arg" = --rela ] && rela=1 || unknown "$arg" ;;
    *) unknown "$arg" ;;
  esac
done

resolve_env
resolve_places

core_pid() {
  local pid; pid="$(cat "$pidfile" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

stop_core() {
  local pid; pid="$(core_pid || true)"
  if [ -n "$pid" ]; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  # A core started by hand (atlas-ops up) on this environment's port is stopped too.
  local other; other="$(lsof -t -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -n "$other" ]; then
    kill -TERM $other 2>/dev/null || true
    for _ in $(seq 1 20); do listening || break; sleep 0.5; done
  fi
  rm -f "$pidfile" "$headfile"
}

start_core() {
  "${ATLAS_CONFIG_PYTHON:-python3}" "$root/rela/scripts/verify.py" "$root/rela"
  echo "atlas-ops: starting the core from $root at $(head_now) (a first start compiles, about half a minute)..."
  mkdir -p "$state"
  nohup "$root/bin/atlas-ops" up --env "$env" >"$log" 2>&1 </dev/null &
  echo $! >"$pidfile"
  head_now >"$headfile"
  for _ in $(seq 1 240); do
    listening && { echo "atlas-ops: core ready"; return 0; }
    kill -0 "$(cat "$pidfile")" 2>/dev/null || { echo "atlas-ops: the core stopped; the last lines of $log:" >&2; tail -20 "$log" >&2; exit 1; }
    sleep 0.5
  done
  echo "atlas-ops: the core did not start within 2 minutes; see $log" >&2
  exit 1
}

# Build output of apps no mix.exs declares any more goes before anything compiles, so a
# renamed app never stops the core from starting (IS-Atlas-67).
clean_build() { "$root/bin/clean-build" "$root" >&2; }

# rela keeps the description it started with. When this build's differs (a merge changed
# rela/schema.yaml), rela is restarted on it first, its data kept (IS-Atlas-73). When the
# new description would leave data without a description (a removed kind or field that
# still has data), nothing is started: that needs a migration first.
ensure_rela() {
  local description="$root/rela/scripts/description.sh" orphans holder
  if ! curl -fsS -o /dev/null "$rela_url/_schema" 2>/dev/null; then
    "$root/rela/scripts/start-bg.sh"
    return
  fi
  "$description" same && return 0

  if ! orphans="$("$description" fits)"; then
    echo "atlas-ops: rela $env runs an older description, and this build's no longer describes data it holds:" >&2
    echo "$orphans" | sed 's/^/  /' >&2
    echo "atlas-ops: migrate that data first (docs/guides/test-on-fly.md, \"A migration\"), then: atlas-ops restart --env $env" >&2
    exit 1
  fi

  if ! "$root/rela/scripts/stop.sh" >/dev/null 2>&1; then
    holder="$(lsof -nP -t -iTCP:"$ATLAS_RELA_PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
    echo "atlas-ops: rela $env runs an older description than this build, and atlas-ops did not start it, so it cannot restart it." >&2
    echo "atlas-ops: stop it (kill ${holder:-<pid>}), then: atlas-ops restart --env $env" >&2
    exit 1
  fi
  "$root/rela/scripts/start-bg.sh" >/dev/null
  echo "atlas-ops: rela $env ran an older description; restarted it on this build's (its data stays)"
}

control_line() {
  if control_answers; then
    echo "control: answers at $host:$port over the tailnet"
  else
    echo "control: does not answer at $host:$port; not on the tailnet: tailscale status"
  fi
}

case "$cmd" in
  # Between this machine and the Fly apps; also while the clients still use this machine's core.
  move-to-fly|fetch-from-fly)
    if [ -z "$fly_rela_app" ]; then
      echo "atlas-ops: $env does not run on Fly ($settings has no \"fly\")" >&2
      exit 1
    fi
    if [ "$cmd" = move-to-fly ]; then export ATLAS_MOVE_FROM="$(setting fly.move_from)"; fi
    exec "$root/fly/$cmd.sh" ${args[@]+"${args[@]}"} ;;
  where) echo "$root"; exit 0 ;;
  main-clone) main_clone; exit 0 ;;
  env) echo "$env $settings"; exit 0 ;;
  install)
    # Only the main clone: a worktree goes away, and its build is not develop.
    if [ "$(main_clone)" != "$root" ]; then
      echo "atlas-ops: install from the main clone ($(main_clone)), not from a worktree" >&2
      exit 1
    fi
    mkdir -p "$HOME/.local/bin"
    # bin/atlas-dev is run from the checkout and never installed.
    for name in atlas atlas-ops; do
      ln -sfn "$root/bin/$name" "$HOME/.local/bin/$name"
      echo "atlas-ops: ~/.local/bin/$name -> $root/bin/$name"
    done
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "atlas-ops: add ~/.local/bin to your PATH" ;; esac
    exit 0 ;;
esac

# What only an environment on Fly does differently: Fly supervises its processes.
if [ -n "$fly_app" ]; then
  if [ "$env" = prod ]; then branch=master; else branch=develop; fi
  on_fly="$env runs on Fly ($fly_app and $fly_rela_app); a merge to $branch deploys it"
  case "$cmd" in
    up) echo "atlas-ops: $on_fly, so there is no core to run here" >&2; exit 1 ;;
    restart|stop)
      echo "atlas-ops: $on_fly, so there is nothing to $cmd here" >&2
      exit 1 ;;
    status)
      echo "env:    $env ($settings), on Fly"
      echo "build:  $root at $(head_now) (this machine's clients; the core is what CI deployed, below)"
      control_line
      fly="$(fly_cli)"
      for app in "$fly_app" "$fly_rela_app"; do
        "$fly" status -a "$app" 2>&1 | sed '/^$/d; s/^/  /' || true
      done
      exit 0 ;;
    logs) exec "$(fly_cli)" logs -a "$fly_app" ;;
  esac
fi

case "$cmd" in
  up)
    ensure_rela
    echo "rela $env: answering at $rela_url"
    clean_build
    cd "$root/beam"
    exec mix run --no-halt
    ;;
  stop)
    stop_core
    if [ -z "$rela" ]; then echo "atlas-ops: core stopped (rela keeps running)"; exit 0; fi
    echo "atlas-ops: core stopped"
    exec "$root/rela/scripts/stop.sh"
    ;;
  restart)
    stop_core
    ensure_rela
    start_core
    ;;
  status)
    echo "env:    $env ($settings)"
    echo "build:  $root at $(head_now)"
    if pid="$(core_pid)"; then
      echo "core:   running (pid $pid, build $(cat "$headfile" 2>/dev/null)), log $log"
    elif listening; then
      echo "core:   a core listens on $port, started by hand (atlas-ops up)"
    else
      echo "core:   not running"
    fi
    "$root/rela/scripts/status.sh" 2>&1 | sed 's/^/rela:   /' || true
    if "$root/rela/scripts/description.sh" same; then
      echo "rela:   description: this build's"
    else
      echo "rela:   description: older than this build's; atlas-ops restart --env $env restarts rela on it"
    fi
    ;;
  logs) exec tail -f "$log" ;;
esac

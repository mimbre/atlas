#!/usr/bin/env bash
# atlas: try Atlas from any folder.
#
#   atlas              open a TUI on prod; prod runs on Fly, so it opens the tunnel to its
#                      Control first (see "On Fly" below). It starts nothing else: for an
#                      environment on this Mac, start rela and the core with `atlas-ops restart`
#   atlas tui          the same; open as many as you like, each in its own terminal
#   atlas discover --machine <name> [--json]   is runtime@<name> registered: a granted read of
#                      Control's registry (ATLAS_RUNTIME_READ_TOKEN). This machine's Runtime node
#                      itself is `atlas-runtime node start|stop|status`
#
#   atlas help [<kind>] [--json]    the agents' commands, and every kind from rela's description:
#                      what a create asks, its id, its parent, its fields (Control must run)
#   atlas put <kind> [--in <key>] --title <text> --description-file <path>   create
#   atlas set <key> <field>=<text> ...       change, e.g. `atlas set IS-Atlas-12 stage=design`
#   atlas get <key> [--json]                 one item, and what hangs under it
#   atlas list <kind> [--json]               the items of a kind
#   atlas delete <key> [--json]              delete; refused while anything hangs under it
#   atlas turn [--json]                     the current turn, its item and what to do
#   atlas turn end <outcome>                 record its outcome; Runtime ends the turn
#   atlas tools [--json]                     the agent's tools: Control's actions, from the description
#   atlas plan --on <key> <request>          what the agent proposes for a request on that page;
#                      it reads through Control and writes nothing (UC-Atlas-16)
#   atlas steer                              the agent behind the TUI's `:`, in JSON lines on
#                      stdin and stdout; the TUI starts it (UC-Atlas-17)
#   atlas migrate-done-owner [--dry-run]     IS-Atlas-88: a done fact has no owner: removes the owner a
#                      migration gave a fact Flow expects nothing of; never one set by hand or Flow
#                      put, set, get, list, delete, tools, plan and the migration go
#                      through Control like the TUI, and start nothing: Control must run (`atlas-ops status`).
#
# On Fly (IS-Atlas-26, IS-Atlas-79): an environment whose settings have a "fly" section runs
# its core and rela on Fly, each environment on its own private network; a merge deploys
# them (develop: test, master: prod). The commands above reach its Control through a
# WireGuard tunnel (`fly proxy`) that they open in the background. With "in_use": false in
# that section (an environment whose data has not moved and been checked yet) the clients
# still use this Mac's core.
#
# Operating an environment (its processes, logs, tunnel, data moves, and installing these
# commands) is `atlas-ops`: `atlas-ops --help`.
#
# Every command works on prod unless it gets --env test: `atlas tui --env test`. Scripts,
# tests and agents always pass --env test, or ATLAS_ENV_FILE: a private instance (other
# ports and data) whose environment is the file's "env", so a trial never meets Melle's.
# --env and the file's "env" must agree. ATLAS_NO_UPDATE=1 keeps `atlas tui` from
# updating the main clone first. ATLAS_AS=<agent key> makes the agents' commands that
# agent (ATLAS_AS=coordinator atlas get IS-Atlas-12): what is assigned to it shows its
# What to do (IS-Atlas-54), and what it writes is by it.
set -euo pipefail

# Keep the read capability out of config/build/lifecycle/proxy children. Only the
# final explicit discovery transport receives it, without putting it in argv.
atlas_discovery_read_grant="${ATLAS_RUNTIME_READ_TOKEN-}"
export -n atlas_discovery_read_grant
unset ATLAS_RUNTIME_READ_TOKEN

# The repository this script lives in, also when it is called through a link.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd -P)"
prog=atlas
. "$root/bin/lib/env.sh"
. "$root/bin/lib/tunnel.sh"
# The comment above, up to `set -euo pipefail`: the usage.
header() { sed -n '2,/^set -euo/p' "$root/bin/atlas" | sed '$d' | sed 's/^# \{0,1\}//'; }
usage() { header; exit 2; }

caller="$PWD"

cmd=tui
case "${1:-}" in -*|"") ;; *) cmd="$1"; shift ;; esac
# A word that is not a command here (operating is atlas-ops) shows the usage and runs nothing.
case "$cmd" in
  tui|turn|put|set|get|list|delete|tools|plan|steer|help|migrate-done-owner|discover) ;;
  *) usage ;;
esac
take_env "$@"
args=()
for arg in ${rest[@]+"${rest[@]}"}; do
  case "$cmd" in
    tui) case "$arg" in -h|--help) usage ;; *) echo "atlas: unknown option $arg" >&2; usage ;; esac ;;
    *) args+=("$arg") ;;
  esac
done

resolve_env

# Reuse the ordinary generated agent client without managing a proxy or service.
run_agent_client() {
  cd "$root/clients/agent"
  mix compile >&2
  if [ "$cmd" = runtime-discover ] && [ -n "$atlas_discovery_read_grant" ]; then
    export ATLAS_RUNTIME_READ_TOKEN="$atlas_discovery_read_grant"
  fi
  ATLAS_CALLER_CWD="$caller" exec mix atlas.agent "$cmd" --env "$env" ${args[@]+"${args[@]}"}
}

# Discovery is the agent client's internal runtime-discover; it needs no tunnel or build cleaning.
if [ "$cmd" = discover ]; then
  cmd=runtime-discover
  run_agent_client
fi

resolve_places

# The main clone follows develop: take the newest build before trying it.
update_build() {
  [ -z "${ATLAS_NO_UPDATE:-}" ] || return 0
  if [ "$(main_clone)" = "$root" ] && [ "$(git -C "$root" branch --show-current)" = develop ]; then
    git -C "$root" pull --ff-only -q || echo "atlas: could not update develop; trying the build as it is" >&2
    # What a rename or a move on develop left behind: folders with only build output.
    "$root/bin/clean-build" "$root" --moved >&2
  fi
}

# Build output of apps no mix.exs declares any more goes before anything compiles, so a
# renamed app never stops the core from starting (IS-Atlas-67).
clean_build() { "$root/bin/clean-build" "$root" >&2; }

# What only an environment on Fly does differently: Control is reached through the tunnel,
# which a command opens when it needs Control (Runtime's broker relies on this unattended).
if [ -n "$fly_app" ]; then
  if [ "$env" = prod ]; then branch=master; else branch=develop; fi
  on_fly="$env runs on Fly ($fly_app and $fly_rela_app); a merge to $branch deploys it"
  case "$cmd" in
    migrate-done-owner) echo "atlas: the migration reads rela on this Mac; $on_fly. Migrate a copy: docs/guides/test-on-fly.md, \"A migration\"" >&2; exit 1 ;;
    turn|put|set|get|list|delete|tools|plan|steer|help) ensure_tunnel ;;
  esac
fi

case "$cmd" in
  tui)
    update_build
    if [ -n "$fly_app" ]; then
      ensure_tunnel
    elif ! listening; then
      # atlas is Control's client: it starts no rela and no core (atlas-ops does).
      echo "atlas: Control for $env does not answer: atlas-ops restart --env $env" >&2
      exit 2
    fi
    clean_build
    # Ctrl-S saves a form; without this the terminal would take it as "pause output".
    saved="$(stty -g 2>/dev/null || true)"
    stty -ixon 2>/dev/null || true
    cd "$root/clients/tui"
    status=0
    mix atlas.tui --env "$env" ${args[@]+"${args[@]}"} || status=$?
    [ -n "$saved" ] && stty "$saved" 2>/dev/null || true
    exit $status
    ;;
  # The clients run in their own folders; a path the caller gives is read from where they called.
  turn|put|set|get|list|delete|tools|plan|steer|help)
    # `atlas help` (not --json) starts with this script's own commands; `atlas help <kind>`
    # shows that kind only.
    kind_named=""
    for arg in ${args[@]+"${args[@]}"}; do case "$arg" in -*) ;; *) kind_named=1 ;; esac; done
    if [ "$cmd" = help ] && [ -z "$kind_named" ] && [[ " ${args[*]-} " != *" --json "* ]]; then
      header; echo
    fi
    clean_build
    run_agent_client
    ;;
  migrate-done-owner)
    cd "$root/tools/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.migrate_done_owner --env "$env" ${args[@]+"${args[@]}"}
    ;;
  *) usage ;;
esac

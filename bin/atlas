#!/usr/bin/env bash
# atlas: try Atlas from any folder.
# It is Control's client: its commands go through Control, as the TUI does, and start
# nothing; Control must run (`atlas-ops status`). Each command is one word after `atlas`.
#
# The person (operator): the Console
#   atlas              open a TUI on prod; prod runs on Fly, so it opens the tunnel to its
#                      Control first (see "On Fly" below). For an environment on this Mac,
#                      start rela and the core with `atlas-ops restart`
#   atlas tui          the same; open as many as you like, each in its own terminal
#
# Working with facts during a turn (agents, the planner, scripts; Runtime for its workers)
#   atlas turn [--json]                      the current turn, its item and what to do
#   atlas turn end <outcome>                 record its outcome; Runtime ends the turn
#   atlas get <key> [--json]                 one item, and what hangs under it
#   atlas facts <kind|_> [<key>] --json      exact stored values and links for gate evidence
#   atlas list <kind> [--json]               the items of a kind
#   atlas set <key> <field>=<text> ...       change, e.g. `atlas set IS-Atlas-12 stage=design`
#   atlas put <kind> [--in <key>] --title <text> --description-file <path>   create
#   atlas delete <key> [--json]              delete; refused while anything hangs under it
#   atlas tools [--json]                     the agent's tools: Control's actions, from the description
#   atlas actions <key> [--json]             the actions Control offers on its page
#   atlas do <key> <action> [--<input> <text> ...] [--json]   do one as the TUI does: its confirm
#                      or form, submitted (--help: its page only); as the person at the TUI
#                      (`tui_user`), unless ATLAS_AS names the agent (agents always set it);
#                      an agent picks up on behalf of whom it assists (IS-Atlas-47)
#   atlas plan --on <key> <request>          what the agent proposes for a request on that page;
#                      it reads through Control and writes nothing (UC-Atlas-16)
#   atlas steer                              the agent behind the TUI's `:`, in JSON lines on
#                      stdin and stdout; the TUI starts it (UC-Atlas-17)
#
# Provisioning (the person or a script)
#   atlas help [<kind>] [--json]    the agents' commands, and every kind from rela's description:
#                      what a create asks, its id, its parent, its fields
#   atlas discover --machine <name> [--json]   is runtime@<name> registered: a granted read of
#                      Control's registry (ATLAS_RUNTIME_READ_TOKEN)
#   atlas migrate-done-owner [--dry-run]     IS-Atlas-88: a done fact has no owner: removes the owner a
#                      migration gave a fact Flow expects nothing of; never one set by hand or Flow
#   atlas migrate-producer [--dry-run]       UC-Atlas-23: links every scene, use case and issue
#                      without a producer to whom its history names (else the decider)
#
# Everything else is another command:
#   atlas-ops          operating an environment: its processes, logs, tunnel, data moves, and
#                      installing these commands (`atlas-ops --help`)
#   bin/atlas-dev      development and test tooling, from the checkout (`bin/atlas-dev --help`)
#   atlas-runtime      the Runtime CLI (platform/atlas_runtime/host/README.md)
#
# On Fly (IS-Atlas-26, IS-Atlas-79): an environment whose settings have a "fly" section runs
# its core and rela on Fly, each environment on its own private network; a merge deploys
# them (develop: test, master: prod). The commands above reach its Control through a
# WireGuard tunnel (`fly proxy`) that they open in the background. With "in_use": false in
# that section (an environment whose data has not moved and been checked yet) the clients
# still use this Mac's core.
#
# Every command works on prod unless it gets --env test: `atlas tui --env test`. Scripts,
# tests and agents always pass --env test, or ATLAS_ENV_FILE: a private instance (other
# ports and data) whose environment is the file's "env", so a trial never meets Melle's.
# --env and the file's "env" must agree. ATLAS_NO_UPDATE=1 keeps `atlas tui` from
# updating the main clone first.
#
# A running TUI takes a release (IS-Atlas-76): when Control closes it as too old, it ends
# (status 75, the page it showed in its handoff file) and `atlas tui` takes the newest
# build as at start (pull, clean-build, compile) and starts it again on that page. When the
# build cannot be made current (the pull failed, the main clone is not on develop, ...) it
# says so and what to do, and starts no TUI into the same refusal.
#
# ATLAS_AS=<agent key> makes the agents' commands that agent (ATLAS_AS=coordinator atlas
# get IS-Atlas-12): what is assigned to it shows its What to do (IS-Atlas-54), and what it
# writes is by it.
set -euo pipefail
# The arguments as given, for a re-exec after update_build pulled a newer develop.
given=("$@")

# This script's own hand-over to itself, never set by a person, kept out of every child:
# ATLAS_UPDATED (update_build pulled already: start the pulled scripts without another
# pull) and, after a TUI was closed as too old, ATLAS_TUI_TO (the page it showed),
# ATLAS_TUI_TOO_OLD (the commit of that build) and ATLAS_TUI_SPECS (Control's contract and
# its own).
updated="${ATLAS_UPDATED-}" tui_to="${ATLAS_TUI_TO-}" too_old="${ATLAS_TUI_TOO_OLD-}" specs="${ATLAS_TUI_SPECS-}"
unset ATLAS_UPDATED ATLAS_TUI_TO ATLAS_TUI_TOO_OLD ATLAS_TUI_SPECS

# Keep the read capability out of config/build/lifecycle/proxy children. Only the
# final explicit discovery transport receives it, without putting it in argv.
atlas_discovery_read_grant="${ATLAS_RUNTIME_READ_TOKEN-}"
export -n atlas_discovery_read_grant
unset ATLAS_RUNTIME_READ_TOKEN

# The repository this script lives in, also when it is called through a link.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  target="$(readlink "$src")"
  case "$target" in /*) src="$target" ;; *) src="$(dirname "$src")/$target" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd -P)"
prog=atlas
. "$root/bin/lib/env.sh"
. "$root/bin/lib/tunnel.sh"
# The comment above, up to `set -euo pipefail`: the usage.
header() { sed -n '2,/^set -euo/p' "$root/bin/atlas" | sed '$d' | sed 's/^# \{0,1\}//'; }
usage() { header; exit 2; }

caller="$PWD"

cmd=tui
case "${1:-}" in -*|"") ;; *) cmd="$1"; shift ;; esac
# A word that is not a command here (operating is atlas-ops) shows the usage and runs nothing.
case "$cmd" in
  tui|turn|put|set|get|facts|list|delete|actions|do|tools|plan|steer|help|migrate-done-owner|migrate-producer|discover) ;;
  *) usage ;;
esac
take_env "$@"
args=()
for arg in ${rest[@]+"${rest[@]}"}; do
  case "$cmd" in
    tui) case "$arg" in -h|--help) usage ;; *) echo "atlas: unknown option $arg" >&2; usage ;; esac ;;
    *) args+=("$arg") ;;
  esac
done

resolve_env

# Presence selects TLS, including an invalid/empty value. Never open a tunnel on failure.
control_selected="${ATLAS_CONTROL_ENDPOINT+x}"
if [ -n "$control_selected" ]; then
  if [[ ! "$ATLAS_CONTROL_ENDPOINT" =~ ^tls://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.tail8263c4\.ts\.net:([0-9]{1,5})$ ]]; then
    echo "atlas: invalid ATLAS_CONTROL_ENDPOINT" >&2; exit 2
  fi
  control_tls_port="${BASH_REMATCH[2]}"
  if (( 10#$control_tls_port < 1 || 10#$control_tls_port > 65535 )); then
    echo "atlas: invalid ATLAS_CONTROL_ENDPOINT port" >&2; exit 2
  fi
  export ATLAS_CONTROL_ENDPOINT
fi

# Reuse the ordinary generated agent client without managing a proxy or service.
run_agent_client() {
  cd "$root/platform/clients/agent"
  mix compile >&2
  if [ "$cmd" = runtime-discover ] && [ -n "$atlas_discovery_read_grant" ]; then
    export ATLAS_RUNTIME_READ_TOKEN="$atlas_discovery_read_grant"
  fi
  ATLAS_CALLER_CWD="$caller" exec mix atlas.agent "$cmd" --env "$env" ${args[@]+"${args[@]}"}
}

# Discovery is the agent client's internal runtime-discover; it needs no tunnel or build cleaning.
if [ "$cmd" = discover ]; then
  cmd=runtime-discover
  run_agent_client
fi

resolve_places

# The main clone follows develop: take the newest build before trying it (bin/lib/update.sh).
# The TUI says update_failed and update_once if Control finds it too old (IS-Atlas-76),
# rather than ending to be started again. After a TUI was closed as too old, not_current
# says what follows a failed pull.
. "$root/bin/lib/update.sh"
update_quiet="$too_old"
restart_updated() {
  ATLAS_UPDATED=1 ATLAS_TUI_TO="$tui_to" ATLAS_TUI_TOO_OLD="$too_old" ATLAS_TUI_SPECS="$specs" \
    exec "$root/bin/atlas" ${given[@]+"${given[@]}"}
}

# After a TUI was closed as too old: the update made no newer build (it failed, or develop
# has nothing newer), so a TUI started now would be refused the same way. Say what is true
# and what to do instead.
not_current() {
  if [ -z "$update_failed" ] && [ "$(git -C "$root" rev-parse HEAD 2>/dev/null)" = "$too_old" ]; then
    update_failed="develop has nothing newer than this build ($(head_now))"
    update_once="develop has a build for contract ${specs%% *}"
  fi
  [ -n "$update_failed" ] || return 0
  echo "atlas: Control $env speaks ${specs%% *}; this build is ${specs#* } and could not be updated: $update_failed. Run atlas again once $update_once." >&2
  exit 1
}

# Build output of apps no mix.exs declares any more goes before anything compiles, so a
# renamed app never stops the core from starting (IS-Atlas-67).
clean_build() { "$root/bin/clean-build" "$root" >&2; }

# What only an environment on Fly does differently: Control is reached through the tunnel,
# which a command opens when it needs Control (Runtime's broker relies on this unattended).
if [ -n "$fly_app" ]; then
  if [ "$env" = prod ]; then branch=master; else branch=develop; fi
  on_fly="$env runs on Fly ($fly_app and $fly_rela_app); a merge to $branch deploys it"
  case "$cmd" in
    migrate-done-owner|migrate-producer) echo "atlas: the migration reads rela on this Mac; $on_fly. Migrate a copy: docs/guides/test-on-fly.md, \"A migration\"" >&2; exit 1 ;;
    turn|put|set|get|facts|list|delete|actions|do|tools|plan|steer|help) [ -n "$control_selected" ] || ensure_tunnel ;;
  esac
fi

case "$cmd" in
  tui)
    update_build
    [ -z "$too_old" ] || not_current
    if [ -n "$control_selected" ]; then
      : # The client verifies TLS before sending hello.
    elif [ -n "$fly_app" ]; then
      ensure_tunnel
    elif ! listening; then
      # atlas is Control's client: it starts no rela and no core (atlas-ops does).
      echo "atlas: Control for $env does not answer: atlas-ops restart --env $env" >&2
      exit 2
    fi
    clean_build
    # Ctrl-S saves a form; without this the terminal would take it as "pause output".
    saved="$(stty -g 2>/dev/null || true)"
    stty -ixon 2>/dev/null || true
    cd "$root/platform/clients/tui"
    to=()
    [ -z "$tui_to" ] || to=(--to "$tui_to")
    # The TUI writes the page it showed here when Control closes it as too old.
    handoff="$(mktemp "${TMPDIR:-/tmp}/atlas-tui.XXXXXX")"
    status=0
    ATLAS_TUI_HANDOFF="$handoff" ATLAS_UPDATE_FAILED="$update_failed" ATLAS_UPDATE_ONCE="$update_once" \
      mix atlas.tui --env "$env" ${to[@]+"${to[@]}"} ${args[@]+"${args[@]}"} || status=$?
    [ -n "$saved" ] && stty "$saved" 2>/dev/null || true
    page="" theirs="" ours=""
    { IFS= read -r page; IFS= read -r theirs; IFS= read -r ours; } <"$handoff" || true
    rm -f "$handoff"
    # Closed as too old: take the newest build as at start, and start it again on that page.
    if [ "$status" = 75 ] && [ -n "$theirs" ]; then
      echo "atlas: Control $env speaks $theirs; this build is $ours. Taking the newest build${page:+, then back to $page}." >&2
      ATLAS_TUI_TO="$page" ATLAS_TUI_TOO_OLD="$(git -C "$root" rev-parse HEAD)" ATLAS_TUI_SPECS="$theirs $ours" \
        exec "$root/bin/atlas" ${given[@]+"${given[@]}"}
    fi
    exit $status
    ;;
  # The clients run in their own folders; a path the caller gives is read from where they called.
  turn|put|set|get|facts|list|delete|actions|do|tools|plan|steer|help)
    # `atlas help` (not --json) starts with this script's own commands; `atlas help <kind>`
    # shows that kind only.
    kind_named=""
    for arg in ${args[@]+"${args[@]}"}; do case "$arg" in -*) ;; *) kind_named=1 ;; esac; done
    if [ "$cmd" = help ] && [ -z "$kind_named" ] && [[ " ${args[*]-} " != *" --json "* ]]; then
      header; echo
    fi
    clean_build
    run_agent_client
    ;;
  migrate-done-owner)
    cd "$root/platform/ops/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.migrate_done_owner --env "$env" ${args[@]+"${args[@]}"}
    ;;
  migrate-producer)
    cd "$root/platform/ops/plan"
    mix compile >&2
    ATLAS_CALLER_CWD="$caller" exec mix atlas.migrate_producer --env "$env" ${args[@]+"${args[@]}"}
    ;;
  *) usage ;;
esac

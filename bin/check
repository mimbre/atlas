#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/check — CI's fast Linux checks, run locally before handing work over (seconds, not minutes).
#
#   bin/check              every Linux job of .github/workflows/ci.yml
#   bin/check beam tui     only those jobs (job ids from ci.yml)
#   bin/check --list       the job ids
#
# It reads the jobs from ci.yml, so it stays in step with CI. It runs each job's `run:` steps in
# the job's working directory with the job's own env, but ONLY the fast static checks: format,
# compile with warnings as errors, lock check, generated-file `--check`s and the boundary greps.
# Test suites (`mix test`, `go test`, unittest, integration scripts) are left to CI. Also skipped, because they only make sense on a
# CI runner: `uses:` steps, steps that need a GitHub expression (`${{ … }}`) or an env value that
# comes from one, installers (pip, hex/rebar, the pinned rela), and the macOS, record and deploy
# jobs. A failing step fails its job; the other jobs still run. Exit 1 when any job failed.

require 'yaml'
require 'open3'

root = File.expand_path('..', __dir__)
workflow = YAML.load_file(File.join(root, '.github/workflows/ci.yml'))
jobs = workflow.fetch('jobs')

skip_jobs = ->(id, job) {
  id == 'tested-tree' || id.start_with?('record-', 'deploy-') || job['runs-on'].to_s.include?('macos')
}
skip_run = /\$\{\{|pip install|local\.hex|local\.rebar|start-test\.sh install|mix test|go( -C \S+)? test|unittest|mix run /
fast = /mix format|mix compile|deps\.get --check-locked|\.gen --check|grep /

linux = jobs.reject { |id, job| skip_jobs.(id, job) }

if ARGV.include?('--list')
  linux.each { |id, job| puts "#{id}\t#{job['name']}" }
  exit 0
end

selected = ARGV.empty? ? linux.keys : ARGV
unknown = selected - linux.keys
abort "bin/check: unknown job(s): #{unknown.join(', ')} (see bin/check --list)" unless unknown.empty?

failed = []
selected.each do |id|
  job = linux.fetch(id)
  started = Time.now
  env = {}
  dropped = []
  (job['env'] || {}).each do |k, v|
    v.to_s.include?('${{') ? dropped << k : env[k] = v.to_s
  end
  default_dir = job.dig('defaults', 'run', 'working-directory') || '.'
  puts "== #{id} (#{job['name']})"
  ok = true
  (job['steps'] || []).each do |step|
    run = step['run'] or next
    step_env = env.dup
    step_dropped = dropped.dup
    (step['env'] || {}).each do |k, v|
      v.to_s.include?('${{') ? step_dropped << k : step_env[k] = v.to_s
    end
    label = step['name'] || run.lines.first.strip
    original = run
    # A multi-line step that mixes fast checks with tests: keep only its plain fast commands.
    if run.lines.size > 1 && run.match?(skip_run) && !run.include?('${{')
      run = run.lines.map(&:strip).grep(/\Amix (format|compile|deps\.get --check-locked|\S+\.gen --check)/).join("\n")
      run = nil if run.empty?
    end
    if run.nil? || run.match?(skip_run) || !run.match?(fast) || step_dropped.any? { |k| run.match?(/\$\{?#{k}\b/) }
      puts "   skip  #{label[0, 90]}"
      next
    end
    dir = File.join(root, step['working-directory'] || default_dir)
    print "   run   #{label[0, 90]} … "
    out, status = Open3.capture2e(step_env, 'bash', '-eo', 'pipefail', '-c', run, chdir: dir)
    if status.success?
      puts 'ok'
    else
      puts 'FAILED'
      puts out.lines.last(40).map { |l| "      #{l}" }.join
      ok = false
      break
    end
  end
  puts "   #{ok ? 'PASS' : 'FAIL'} #{id} in #{(Time.now - started).round}s"
  failed << id unless ok
end

if failed.empty?
  puts "bin/check: all #{selected.size} job(s) passed"
else
  puts "bin/check: FAILED: #{failed.join(', ')}"
  exit 1
end
